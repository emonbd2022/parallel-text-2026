rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    // Verify if the caller is an authenticated Firebase user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verify if the caller has administrator privileges
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email in ['elarainfinity@gmail.com', 'titaniumfact97@gmail.com', 'reactoremon2022@gmail.com']) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Strict allowlist of essential account fields for newly created documents.
    function hasOnlyEssentialAccountFields() {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'name', 'photoURL', 'nickname',
        'credits', 'unlimited', 'totalProcessedImages',
        'joinDate', 'createdAt', 'blocked', 'role',
        'plan', 'planStartDate', 'planEndDate',
        'deviceIds', 'devices', 'centralApiAccess', 'lastActiveAt',
        'deviceLimitReached', 'subscriptionExpiresAt'
      ]);
    }

    // Strict allowlist of notification fields.
    // Enforced for BOTH normal users and administrators.
    function hasOnlyNotificationFields() {
      return request.resource.data.keys().hasOnly([
        'id', 'targetUid', 'type', 'message', 'userName', 'userEmail', 'createdAt', 'read',
        'paymentId', 'trxId', 'amount', 'method', 'userUid'
      ]);
    }

    // Absolute prohibition of Local-First application state in Firestore.
    // Enforced for BOTH normal users and administrators across all collections.
    function hasNoForbiddenLocalData() {
      return !request.resource.data.keys().hasAny([
        'apiKeys', 'appData', 'config', 'preferences', 'apiUsage',
        'cooldowns', 'errors', 'queue', 'progress', 'processingData',
        'csvData', 'temporaryStats', 'history', 'logs', 'activityLogs',
        'processingSessions', 'stats'
      ]);
    }

    // =========================================================
    // USERS COLLECTION
    // Stores ONLY essential user/account metadata.
    // Local-First data is completely blocked for ALL users (including admins).
    // =========================================================
    match /users/{userId} {
      // Read: Users can read their own account; Admins can read all accounts.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Create: Enforces schema allowlist for ALL users.
      // Normal users are additionally restricted to prevent privilege escalation.
      allow create: if isAuthenticated() && 
        hasOnlyEssentialAccountFields() && 
        hasNoForbiddenLocalData() && 
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            request.resource.data.uid == userId &&
            request.resource.data.role == 'user' &&
            request.resource.data.blocked == false &&
            request.resource.data.unlimited == false &&
            request.resource.data.plan == 'free' &&
            request.resource.data.credits is number &&
            request.resource.data.credits >= 0 &&
            request.resource.data.credits <= 100 &&
            request.resource.data.totalProcessedImages is number &&
            request.resource.data.totalProcessedImages == 0 &&
            (
              !('deviceIds' in request.resource.data) ||
              (request.resource.data.deviceIds is list && request.resource.data.deviceIds.size() <= 2)
            ) &&
            (
              !('devices' in request.resource.data) ||
              (request.resource.data.devices is list && request.resource.data.devices.size() <= 2)
            )
          )
        );

      // Update: Prohibits local-first data while allowing profile/device metadata updates
      allow update: if isAuthenticated() && 
        hasNoForbiddenLocalData() && 
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'credits', 'totalProcessedImages', 'deviceIds', 'devices', 
              'lastActiveAt', 'nickname', 'name', 'photoURL', 'deviceLimitReached'
            ]) &&
            (
              !('credits' in request.resource.data.diff(resource.data).affectedKeys()) ||
              (
                request.resource.data.credits is number &&
                request.resource.data.credits >= 0 &&
                request.resource.data.credits <= resource.data.credits
              )
            ) &&
            (
              !('totalProcessedImages' in request.resource.data.diff(resource.data).affectedKeys()) ||
              (
                request.resource.data.totalProcessedImages is number &&
                request.resource.data.totalProcessedImages >= resource.data.totalProcessedImages &&
                request.resource.data.totalProcessedImages >= 0
              )
            ) &&
            (
              !('deviceIds' in request.resource.data.diff(resource.data).affectedKeys()) ||
              (
                request.resource.data.deviceIds is list &&
                request.resource.data.deviceIds.size() <= 2 &&
                (
                  !('deviceIds' in resource.data) ||
                  request.resource.data.deviceIds.hasAll(resource.data.deviceIds)
                )
              )
            ) &&
            (
              !('devices' in request.resource.data.diff(resource.data).affectedKeys()) ||
              (
                request.resource.data.devices is list &&
                request.resource.data.devices.size() <= 2
              )
            )
          )
        );

      // Delete: Strictly restricted to administrators
      allow delete: if isAdmin();
    }

    // =========================================================
    // NOTIFICATIONS COLLECTION
    // Two-way lightweight notifications (admin alerts & global user announcements)
    // Enforced against schema allowlist for BOTH admins and normal users.
    // =========================================================
    match /notifications/{notificationId} {
      // Read: Admins can read all. Users can read global or their own personal notifications.
      allow read: if isAuthenticated() && (isAdmin() || resource.data.targetUid == 'all' || resource.data.targetUid == request.auth.uid);

      // Create: Admins can create. Users can create signup alert or subscription payment request to admin.
      allow create: if isAuthenticated() &&
        hasOnlyNotificationFields() &&
        hasNoForbiddenLocalData() &&
        request.resource.data.createdAt is string &&
        request.resource.data.read is bool &&
        (
          (isAdmin() && request.resource.data.targetUid in ['admin', 'all', request.resource.data.targetUid]) ||
          (
            request.resource.data.targetUid == 'admin' &&
            notificationId == ('signup_' + request.auth.uid) &&
            request.resource.data.type == 'signup' &&
            request.resource.data.id == ('signup_' + request.auth.uid) &&
            request.resource.data.userName is string &&
            request.resource.data.userEmail is string &&
            request.resource.data.message is string &&
            request.resource.data.read == false
          ) ||
          (
            request.resource.data.targetUid == 'admin' &&
            request.resource.data.type == 'subscription_request' &&
            request.resource.data.userUid == request.auth.uid &&
            request.resource.data.read == false
          )
        );

      // Update: Restricted to administrators (or user marking their own notification as read)
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.targetUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
      );

      // Delete: Restricted to administrators
      allow delete: if isAdmin();
    }

    // =========================================================
    // PAYMENTS COLLECTION
    // Subscription payments (bKash / Nagad 200 BDT)
    // =========================================================
    match /payments/{paymentId} {
      // Read: Admins can read all payments; Users can read their own payment records
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);

      // Create: Authenticated users can create pending payment request for themselves
      allow create: if isAuthenticated() &&
        hasNoForbiddenLocalData() &&
        request.resource.data.keys().hasOnly([
          'id', 'userId', 'userEmail', 'userName', 'amount', 'method', 'trxId',
          'status', 'plan', 'durationDays', 'createdAt', 'approvedAt', 'rejectedAt',
          'expiresAt', 'rejectionReason', 'adminNote'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount == 200 &&
        request.resource.data.trxId is string &&
        request.resource.data.trxId.size() >= 3 &&
        request.resource.data.method in ['bkash', 'nagad'];

      // Update: Only administrators can approve/reject payment requests
      allow update: if isAdmin();

      // Delete: Only administrators can remove records
      allow delete: if isAdmin();
    }

    // =========================================================
    // SETTINGS COLLECTION
    // System settings (e.g. maintenanceMode)
    // =========================================================
    match /settings/{document} {
      // Read: Authenticated users only
      allow read: if isAuthenticated();
      // Write: Administrators only
      allow write: if isAdmin();
    }

    // =========================================================
    // CENTRAL API KEYS COLLECTION
    // Centralized crowdsourced & admin-provided API keys in Firestore
    // ALL central keys are stored in exactly ONE document: central_keys/APIkeys
    // Protected: Stored with server-side AES-256 encryption.
    // Allows writes so user contributions are stored in Firestore.
    // =========================================================
    match /central_keys/{keyDocId} {
      // Read & Write: Open for central keys document so user contributions and server sync can write & read the single doc
      allow read, write: if true;
    }

    // =========================================================
    // DEFAULT DENY
    // All other collections and paths are completely inaccessible
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
