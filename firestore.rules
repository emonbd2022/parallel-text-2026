rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTHENTICATION
    // =========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin status is currently stored in users/{uid}.role.
    // This can later be migrated to Firebase Auth custom claims
    // to eliminate the Firestore lookup during rule evaluation.
    function isAdmin() {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // =========================================================
    // USER DOCUMENTS
    // =========================================================

    match /users/{userId} {

      // Owner can read own document.
      // Admin can read any user document.
      allow read: if isAuthenticated()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      // Users can create only their own account document.
      allow create: if isAuthenticated()
        && request.auth.uid == userId;

      // Admins can update any user document.
      //
      // Normal users may update ONLY explicitly allowed
      // non-sensitive configuration fields.
      allow update: if isAuthenticated()
        && (
          isAdmin()
          ||
          (
            request.auth.uid == userId
            &&
            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'appData',
                'apiKeys',
                'settings',
                'preferences'
              ])
          )
        );

      // Only admins can delete users.
      allow delete: if isAdmin();


      // =======================================================
      // USER ACTIVITY SUMMARY
      // =======================================================

      match /stats/summary {

        // User can read own summary.
        // Admin can read any user's summary.
        allow read: if isAuthenticated()
          && (
            request.auth.uid == userId
            || isAdmin()
          );

        // User may create/update only their own summary.
        //
        // Validate the basic structure and prevent negative
        // aggregate values.
        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.totalProcessed is int
          && request.resource.data.totalProcessed >= 0;

        allow update: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.totalProcessed is int
          && request.resource.data.totalProcessed >= 0;

        // Activity summary should never be deleted by users.
        // Admin deletion is also disabled to preserve history.
        allow delete: if false;
      }
    }


    // =========================================================
    // CSV EXPORTS
    // =========================================================

    match /csv_exports/{exportId} {

      // User can read/delete only their own exports.
      // Admin can read/delete all exports.
      allow read, delete: if isAuthenticated()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );

      // Users can create exports only for themselves.
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;

      // Existing exports cannot be modified.
      allow update: if false;
    }


    // =========================================================
    // SETTINGS
    // =========================================================

    match /settings/{document} {

      // Settings are publicly readable only if your application
      // intentionally requires this.
      allow read: if true;

      // Only admins can modify settings.
      allow write: if isAdmin();
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notifId} {

      // Users can read:
      // - their own notifications
      // - global notifications
      //
      // Admins can read admin-targeted notifications.
      allow read: if isAuthenticated()
        && (
          resource.data.targetUid == request.auth.uid
          || resource.data.targetUid == 'all'
          || (
            resource.data.targetUid == 'admin'
            && isAdmin()
          )
        );

      // Admins can create any notification.
      //
      // Authenticated users may create a notification only
      // when specifically targeting the admin account.
      allow create: if isAdmin()
        || (
          isAuthenticated()
          && request.resource.data.targetUid == 'admin'
        );

      // Users can modify/delete their own notifications.
      // Admins can modify/delete admin notifications.
      allow update, delete: if isAuthenticated()
        && (
          resource.data.targetUid == request.auth.uid
          || (
            resource.data.targetUid == 'admin'
            && isAdmin()
          )
        );
    }
  }
}